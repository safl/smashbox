#!/bin/sh
# Set the wifi regulatory country and unblock the radio. Required on
# RPi OS first boot — until a country is set, wifi is soft-blocked by
# rfkill and won't show up in nmtui.
#
# Re-run safely at every boot; idempotent.
set -eu

COUNTRY_FILE=/etc/default/smashbox-wifi
COUNTRY=DK
if [ -r "$COUNTRY_FILE" ]; then
    # shellcheck disable=SC1090
    . "$COUNTRY_FILE"
fi

if command -v iw >/dev/null 2>&1; then
    iw reg set "$COUNTRY" 2>/dev/null || true
fi
if command -v rfkill >/dev/null 2>&1; then
    rfkill unblock all 2>/dev/null || true
fi

# Hint NetworkManager / wpa_supplicant about the country too — picked up
# on next start.
mkdir -p /etc/NetworkManager/conf.d
cat > /etc/NetworkManager/conf.d/30-wifi-country.conf <<EOF
[device]
wifi.country=$COUNTRY
EOF
